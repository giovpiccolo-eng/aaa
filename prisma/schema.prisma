generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  role          Role      @default(TEACHER)
  accounts      Account[]
  sessions      Session[]
  notes         Note[]
  createdAt     DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Assignment {
  id         String   @id @default(cuid())
  yearGroup  Int
  stream     String
  userId     String
  updatedAt  DateTime @updatedAt

  @@unique([yearGroup, stream])
}

model ThemeStatus {
  id        String   @id @default(cuid())
  themeKey  String   @unique
  status    String   @default("not-started")
  pacing    String   @default("on-track")
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model SyncState {
  id        String   @id @default(cuid())
  syncKey   String   @unique
  aligned   Boolean  @default(false)
  reason    String?
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model Note {
  id        String   @id @default(cuid())
  syncKey   String
  content   String   @db.Text
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
}

enum Role {
  TEACHER
  COORDINATOR
}
