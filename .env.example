# Copy this to .env.local and fill in real values

# PostgreSQL connection string from Supabase
# Settings → Database → Connection string (URI) → add ?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres:[password]@[host]:5432/postgres?pgbouncer=true&connection_limit=1"

# Google OAuth — from console.cloud.google.com
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-random-secret"

# Your Vercel deployment URL (or http://localhost:3000 for dev)
NEXTAUTH_URL="https://your-app.vercel.app"
